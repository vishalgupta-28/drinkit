# Production (Vercel) — FRONTEND-ONLY deploy.
# No backend is hosted here, so these are intentionally empty: API calls then
# fail same-origin (fast 404) and the app uses its built-in fallbacks —
# mock catalog data, localStorage auth, and simulated (test) payment.
#
# To connect a real backend later, set NEXT_PUBLIC_API_URL to its HTTPS URL
# (e.g. https://api.yourdomain.com/api) and NEXT_PUBLIC_WS_URL to its WS origin.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
